PORT=3000
DATA_DIR=./data
STORAGE_DRIVER=sqlite
ADMIN_USER=admin
ADMIN_PASSWORD=adminadmin
# Docker Compose settings (the remote deployment script sets image/port/data explicitly).
ICONFAMILY_IMAGE=icon-family:latest
ICONFAMILY_PORT=3000
ICONFAMILY_DATA_DIR=/home/icon-family/data
# If the runtime does not trust the corporate CA, point this to a PEM bundle.
# ICONFONT_CA_FILE=
# Development-only fallback; keep disabled in production.
# ICONFONT_INSECURE_TLS=0

{
  "name": "iconfamily",
  "version": "0.1.0",
  "private": true,
  "description": "A compact icon library manager with iconfont search/import and deterministic iconfont.js builds.",
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "start": "node --use-system-ca server/index.mjs",
    "dev": "concurrently -k -n api,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --use-system-ca --watch server/index.mjs",
    "dev:web": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests vite.config.ts playwright.config.ts tsconfig.json",
    "test": "npm run test:server && npm run test:e2e",
    "test:server": "node --test tests/*.test.mjs",
    "test:e2e": "npm run build && playwright test",
    "test:runtime": "node scripts/check-runtime.mjs",
    "build": "npm run typecheck && vite build && node scripts/package.mjs --check",
    "package": "npm run build && node scripts/package.mjs",
    "deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy.ps1"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "antd": "^6.6.5",
    "dompurify": "^3.4.15",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
